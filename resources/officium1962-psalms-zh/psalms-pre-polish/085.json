  "lines": {
    "85:1": {
      "from": "上主，求你侧耳",
      "mk": [
        "俯听我，"
      ]
    },
    "85:2": {
      "zh": "求你保护我的灵魂，因为**我是圣善的**， * **我的天主，求你拯救仰望你的仆人。**",
      "note": "武加大 sanctus sum 是「我是圣善的」，Deus meus 称呼我的天主；思高作「我热爱你」，并说「因为我仰望你」。"
    },
    "85:3": {
      "zh": "求你怜悯我；上主，因为我时常向你哀告。 * 求你使你的仆人心灵欢欣。上主，我向你举起我的心神。",
      "note": "思高「你是我的天主」属于上一拉丁行的 Deus meus，此处不重复。"
    },
    "85:5": {
      "mk": [
        "慈悯，"
      ]
    },
    "85:6": {
      "mk": [
        "祈祷，"
      ]
    },
    "85:7": {
      "mk": [
        "呼号，"
      ]
    },
    "85:8": {
      "mk": [
        "相似，"
      ]
    },
    "85:9": {
      "mk": [
        "崇拜你，"
      ]
    },
    "85:10": {
      "mk": [
        "奇谋，"
      ]
    },
    "85:11": {
      "mk": [
        "去行；"
      ],
      "fix": [
        [
          "求你指引我心",
          "**愿我的心欢喜**"
        ]
      ],
      "note": "武加大 laetetur cor meum 是愿我的心欢喜；思高说求你指引我心。"
    },
    "85:12": {
      "zh": "上主，我的天主，我要全心向你赞颂， * 我要永远光荣你的圣名。",
      "note": "仅调整呼语的位置，以配合武加大的半行。"
    },
    "85:13": {
      "mk": [
        "无边，"
      ]
    },
    "85:14": {
      "mk": [
        "我的性命，"
      ],
      "fix": [
        [
          "骄傲的人",
          "**作恶的人**"
        ],
        [
          "蛮横的一群人",
          "**强暴的一群人**"
        ]
      ],
      "note": "武加大 iniqui 与 potentium 分别说作恶的人和强暴者；思高作骄傲的人和蛮横的人。"
    },
    "85:15": {
      "mk": [
        "天主，"
      ]
    },
    "85:16": {
      "mk": [
        "怜悯我，"
      ]
    },
    "85:17": {
      "mk": [
        "羞愧难过。"
      ],
      "fix": [
        [
          "缓助",
          "**援助**"
        ]
      ],
      "note": "思高 EPUB 作「缓助」；拉丁 adjuvisti 是援助，此处按拉丁改译。"
    }
  }
}
